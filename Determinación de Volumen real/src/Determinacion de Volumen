from CoolProp.CoolProp import PropsSI
import numpy as np

list_sustancias = []
list_V = []
list_e_rel = []
dict_V = {}
dict_e_rel = {}

#V es el Volumen según el modelo usado, mientras V_real es el volumen medido en el laboratorio

def model_GI(P, T, V_real):
    Z = 1
    V = Z*R*T/P
    e_rel = ((V_real - V)/V_real)*100

    return Z, V, e_rel

def model_VdW(P, T, Tc, Pc, V_real):
    a = (27/64)*(R*Tc)**2/Pc
    b = R*Tc/(8*Pc)
    A = a*P/(R*T)**2
    B = b*P/(R*T)

    Z = np.roots([1 , -(1 + B) , A , -A*B])
    V = Z*R*T/P
    e_rel = ((V_real - V)/V_real)*100

    return Z, V, e_rel

def model_RK(P, T, Tc, Pc, V_real):
    a = 0.42748*R**2*Tc**2.5/Pc
    b = 0.08664*R*Tc/Pc
    A = a*P/(R**2*T**2.5)
    B = b*P/(R*T)

    Z = np.roots([1 , -1 , (A - B - B**2) , -A*B])
    V = Z*R*T/P
    e_rel = ((V_real - V)/V_real)*100

    return Z, V, e_rel

def model_SRK(P, T, Tc, Pc, omega, V_real):
    a = 0.42748*R**2*Tc**2/Pc
    b = 0.08664*R*Tc/Pc
    m = 0.48 + 1.574*omega - 0.176*omega**2
    alfa = (1 + m*(1 - np.sqrt(T/Tc)))
    A = a*alfa*P/(R*T)**2
    B = b*P/(R*T)

    Z = np.roots([1 , -1 , (A - B - B**2) , -A*B])
    V = Z*R*T/P
    e_rel = ((V_real - V)/V_real)*100

    return Z, V, e_rel

def model_PR(P, T, Tc, Pc, omega, V_real):
    a = 0.45724*((R*Tc)**2/Pc)
    b = 0.0778*R*Tc/Pc
    k = 0.37464 + 1.54226*omega - 0.26992*omega**2
    alfa = (1 + k*(1 - np.sqrt(T/Tc)))**2
    A = a*alfa*P/(R*T)**2
    B = b*P/(R*T)

    Z = np.roots([1 , -(1 - B) , A - 3*B**2 - 2*B , -(A*B - B**2 - B**3)])
    V = Z*R*T/P
    e_rel = ((V_real - V)/V_real)*100

    return Z, V, e_rel

num_sustancias = int(input('Cuantas sustancias quieres analizar? '))

for i in range(num_sustancias):

    sustancia = str(input('Que sustancia quieres analizar? Usa un nombre válido: '))
    list_sustancias.append(sustancia)

    P = float(input('A que presión está el sistema? (Pa): '))
    T = float(input('A que temperatura está el sistema? (K): '))
    R = 8.3145

    Tc = PropsSI('Tcrit','T',T,'P',P,sustancia)
    Pc = PropsSI('Pcrit','T',T,'P',P,sustancia)
    omega = PropsSI('acentric',sustancia)

    D = PropsSI('Dmolar','T',T,'P',P,sustancia) # [D] = mol/m^3
    V_real = 1/D # [V_real] = m^3/mol

    _,V_GI,e_relGI = model_GI(P,T,V_real)
    _,V_VdW,e_relVdW = model_VdW(P,T,Tc,Pc,V_real)
    _,V_RK,e_relRK = model_RK(P,T,Tc,Pc,V_real)
    _,V_SRK,e_relSRK = model_SRK(P,T,Tc,Pc,omega,V_real)
    _,V_PR,e_relPR = model_PR(P,T,Tc,Pc,omega,V_real)

    list_e_rel = [('GI',e_relGI), ('VdW', e_relVdW), ('RK', e_relRK), ('SRK', e_relSRK), ('PR', e_relPR)]
    list_e_rel = sorted(list_e_rel, key = lambda x: x[1]) #En la linea 95 e_rel puede ser una lista de 3 raices e_rel. Problema
    dict_e_rel[sustancia] = list_e_rel

    list_V.append((V_GI,V_VdW,V_RK,V_SRK,V_PR))
    dict_V[sustancia] = list_V
    
print('\nError relativo ordenado de menor a mayor:\n')

print(dict_e_rel)